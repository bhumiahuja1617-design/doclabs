# Environment Variables for DockLab
PROJECT_NAME="DockLab"
ENV="development"
DEBUG=true

# Database
POSTGRES_USER="docklab"
POSTGRES_PASSWORD="replace-with-a-long-random-url-safe-secret"
POSTGRES_DB="docklab"
DATABASE_URL="postgresql+psycopg://docklab:replace-with-a-long-random-url-safe-secret@postgres:5432/docklab"
TEST_DATABASE_URL="sqlite+aiosqlite:///./test.db"

# Redis & Celery
REDIS_URL="redis://redis:6379/0"
CELERY_BROKER_URL="redis://redis:6379/0"
CELERY_RESULT_BACKEND="redis://redis:6379/1"

# Storage
DATA_DIR="/data"
MAX_UPLOAD_SIZE_MB=10
MAX_MOLECULES_PER_JOB=200
JOB_RETENTION_DAYS=7

# Vina & Docking Settings
DEFAULT_EXHAUSTIVENESS=8
MAX_EXHAUSTIVENESS=32
DEFAULT_VINA_TIMEOUT_SECONDS=600
RELIABILITY_MAX_LIGANDS=20
RELIABILITY_MAX_SEEDS=10

# API Security & CORS
CORS_ORIGINS='["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]'

